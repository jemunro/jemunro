{
  "name": "Quarto Portfolio",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/rocker-org/devcontainer-features/quarto-cli:1": {
      "version": "release"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "quarto.quarto",
        "redhat.vscode-yaml",
        "anthropic.claude-code"
      ]
    }
  },
  // Start the Quarto preview each time you attach (script skips if already running).
  // Log: /tmp/quarto-preview.log. Stop with: pkill -f "quarto preview"
  "postAttachCommand": "bash .devcontainer/start-preview.sh",
  "forwardPorts": [4200],
  "portsAttributes": {
    "4200": {
      "label": "Quarto preview",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    }
  }
}
